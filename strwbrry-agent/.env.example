# Laddr Environment Configuration
# ===================================
# Complete reference for all available environment variables.
# Uncomment and set the ones you need for your project.

# ===================================
# Infrastructure Backends
# ===================================

# Database Configuration
# For lightweight local development, use SQLite:
DATABASE_URL=sqlite:///./laddr.db
# For production with Docker:
# DATABASE_URL=postgresql://laddr:laddr@postgres:5432/laddr

# Message Broker
# For lightweight local development, use memory:
REDIS_URL=memory://
# For production with Docker:
# REDIS_URL=redis://redis:6379
# KAFKA_BOOTSTRAP=kafka:9092


# ===================================
# Storage Backend (S3-Compatible)
# ===================================
# Supports AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2, etc.
# For AWS S3: set STORAGE_ENDPOINT=s3.amazonaws.com, STORAGE_SECURE=true, STORAGE_REGION=us-east-1
# For MinIO: set STORAGE_ENDPOINT=minio:9000 or localhost:9000, STORAGE_SECURE=false
# See STORAGE_MIGRATION_GUIDE.md for detailed instructions

# New storage configuration (recommended):
# STORAGE_ENDPOINT=s3.amazonaws.com
# STORAGE_ACCESS_KEY=your-access-key-id
# STORAGE_SECRET_KEY=your-secret-access-key
# STORAGE_SECURE=true
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=laddr

# MinIO configuration:
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_SECURE=false
# STORAGE_BUCKET=laddr

# Large Response Storage
# Automatically offload large responses to storage backend
ENABLE_LARGE_RESPONSE_STORAGE=true
STORAGE_THRESHOLD_KB=100

# ===================================
# API Server
# ===================================
API_HOST=0.0.0.0
API_PORT=8000
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dashboard
# DASHBOARD_URL=http://localhost:5173

# ===================================
# Tracing & Metrics
# ===================================
# Built-in observability (stored in database)
# ENABLE_TRACING=true
# ENABLE_METRICS=true

# ===================================
# Backend Selection
# ===================================
# Choose which backends to use (defaults shown)
QUEUE_BACKEND=memory      # Options: redis, memory (use memory for local dev)
DB_BACKEND=sqlite         # Options: postgres, sqlite (use sqlite for local dev)
LLM_BACKEND=openai        # Options: noop, openai, anthropic, gemini, groq, grok
# CACHE_BACKEND=inmemory  # Options: inmemory, redis

# LLM Model Configuration
# Default: OpenRouter with Claude Sonnet
LLM_MODEL=anthropic/claude-3.5-sonnet
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Alternative: Local Ollama (uncomment to use)
# LLM_BACKEND=openai
# LLM_MODEL=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama  # Ollama doesn't need real key but field required


# Worker Scaling (Docker Compose)
RESEARCHER_SCALE=1
COORDINATOR_SCALE=1
# Add more as needed: RESEARCHER_SCALE=2, WRITER_SCALE=1, etc.

# ===================================
# Per-Agent LLM Models
# ===================================
# Configure different models for each agent
# Using Claude Sonnet via OpenRouter
RESEARCHER_MODEL=anthropic/claude-3.5-sonnet
COORDINATOR_MODEL=anthropic/claude-3.5-sonnet
# Optionally use faster/cheaper model for some agents:
# RESEARCHER_MODEL=anthropic/claude-3-haiku

# ===================================
# LLM API Keys
# ===================================
# Provide API keys for the LLM providers you want to use

# OpenRouter API Key (for Claude Sonnet via OpenRouter)
# Get your key at: https://openrouter.ai/keys
OPENAI_API_KEY=your-openrouter-api-key-here

# If using direct OpenAI instead:
# OPENAI_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Groq
# GROQ_API_KEY=gsk_...

# xAI Grok
# XAI_API_KEY=xai-...
# GROK_API_KEY=xai-...  # Alias for XAI_API_KEY

# HTTP LLM (Generic endpoint)
# HTTP_LLM_ENDPOINT=http://localhost:8080/generate

# ===================================
# Tool API Keys
# ===================================

# Serper.dev (Web Search Tool)
# Required for web_search tool used by researcher agents
# Get a free API key at: https://serper.dev (2,500 searches/month free tier)
SERPER_API_KEY=

# Add more tool API keys as needed
# TAVILY_API_KEY=...
# BROWSERLESS_API_KEY=...


# ===================================
# Dashboard Authentication
# ===================================
# Optional basic auth for dashboard (format: username:password)
# EVENAGE_DASH_USERS=admin:admin

# ===================================
# Execution Limits
# ===================================
# Control agent execution behavior (can be overridden per-task)
# MAX_ITERATIONS=10        # Maximum think-act cycles per agent task
# MAX_TOOL_CALLS=          # Maximum successful tool calls (unset = unlimited)

# ===================================
# Development & Debugging
# ===================================
# LOG_LEVEL=INFO
# DEBUG=false
# VERBOSE=false

# ===================================
# Strwbrry Vault Configuration
# ===================================
# Path to your Strwbrry vault (required for Advisory Council)
# Update this to point to your actual vault location
VAULT_PATH=/path/to/Documents/SPLN

